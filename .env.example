# ==============================================================================
# STOCKTRACE ENVIRONMENT CONFIGURATION TEMPLATE
# Safe placeholders only. Never commit production credentials or secret keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & EMBEDDING PROVIDER (GEMINI / VERTEX AI)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini Generative AI API calls (Gemini 2.5 Flash / Pro).
# In production, inject via Google Cloud Secret Manager or runtime container env.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Configured LLM Model for grounded response generation
VITE_LLM_MODEL="gemini-2.5-flash"

# Embedding model for pgvector / semantic retrieval (e.g., text-embedding-004, 768 dims)
VITE_EMBEDDING_MODEL="text-embedding-004"

# ------------------------------------------------------------------------------
# 2. RELATIONAL DATABASE & SUPABASE (POSTGRESQL + PGVECTOR)
# ------------------------------------------------------------------------------
# Database URL for migrations and backend services (PostgreSQL 15+ with pgvector)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase public URL and anonymous public key for client-side queries
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key: BACKEND ONLY. Never expose to client-side code!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. APPLICATION & HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
# APP_URL: The base URL where this application is hosted.
APP_URL="http://localhost:5173"

# Warehouse Identifier for multi-tenant isolation
VITE_WAREHOUSE_ID="BLR-NORTH-WH01"

# ------------------------------------------------------------------------------
# 4. SUPERVISOR & ESCALATION WORKFLOW
# ------------------------------------------------------------------------------
# VITE_SUPERVISOR_EMAIL: Recipient email for high-priority operational escalations
VITE_SUPERVISOR_EMAIL="supervisor@warehouse.internal"

# VITE_GOOGLE_CLIENT_ID: OAuth 2.0 Web Client ID for client-side Gmail API authorization (gmail.send scope)
VITE_GOOGLE_CLIENT_ID=""

# ------------------------------------------------------------------------------
# 5. GOVERNANCE & EXECUTION THRESHOLDS
# ------------------------------------------------------------------------------
# Maximum tool calls allowed per single investigation run to prevent infinite loops
VITE_MAX_TOOL_CALLS_PER_INVESTIGATION=8

# Investigation execution timeout in milliseconds
VITE_INVESTIGATION_TIMEOUT_MS=15000
