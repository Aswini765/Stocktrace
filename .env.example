# StockTrace — environment variables (placeholders only; never commit real values)
NODE_ENV=development
PORT=3000

# Shared data across phones and laptops (optional). Without these the app runs in
# "this device only" mode. Values come from Supabase: Project Settings -> API.
# The anon key is a public, browser-safe key; access is limited by the table's row-level security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_STOCKTRACE_WORKSPACE=demo
